<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Space Battle X - Multi-Bonus</title>
    <style>
        body { 
            margin: 0; 
            background: linear-gradient(135deg, #0a0a0f 0%, #1a0a2e 50%, #0f0a1f 100%);
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            overflow: hidden; 
            font-family: 'Orbitron', 'Segoe UI', Arial, sans-serif;
        }
        canvas { 
            border: 3px solid #00ffff;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.5), inset 0 0 30px rgba(0, 255, 255, 0.1);
            background: radial-gradient(circle at 30% 20%, #1a0a3e, #0a0a1f, #000);
        }
    </style>
</head>
<body>

<canvas id="game" width="420" height="650"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let state = "lobby"; 
let keys = {}, bullets = [], enemies = [], particles = [], stars = [], bonuses = [];
let enemyTimer = 0;

// ⚡ STATUS INDEPENDIENTES
let speedTimer = 0;
let multiTimer = 0;
const BONUS_DURATION = 400; 

// 🛡️ ESCUDO
let shieldReady = false, shieldActive = false, shieldTimer = 0, enemyKills = 0;

// 💾 DATOS
let save = JSON.parse(localStorage.getItem("spaceSave")) || { score: 0, owned: [true, false, false, false, false] };
let score = save.score;

const ships = [
    { color: "#00ffff", speed: 6, price: 0, glow: "#00ffff" },
    { color: "#ff0066", speed: 6, price: 100, glow: "#ff00ff" },
    { color: "#00ff88", speed: 8, price: 250, glow: "#00ff88" },
    { color: "#ff6b00", speed: 7, price: 500, glow: "#ffaa00" },
    { color: "#ff00ff", speed: 7, price: 1200, glow: "#ff00ff" }
];

let shipIndex = 0;
const player = { x: 210, y: 560 };

for(let i=0; i<150; i++) stars.push({ x: Math.random()*420, y: Math.random()*650, s: Math.random()*2.5 + 0.5, br: Math.random()*255 });

// --- CLICS ---
canvas.addEventListener("mousedown", e => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;

    if(state === "lobby") {
        if(mx > 100 && mx < 320 && my > 420 && my < 475) startGame();
        if(Math.hypot(mx - 370, my - 580) < 30) state = "shop";
        if(mx > 45 && mx < 85 && my > 275 && my < 335) changeShip(-1);
        if(mx > 335 && mx < 375 && my > 275 && my < 335) changeShip(1);
    } else if(state === "shop") {
        if(mx > 80 && mx < 340 && my > 430 && my < 480) buyShip();
        if(my > 580) state = "lobby";
        if(mx > 45 && mx < 85 && my > 275 && my < 335) shipIndex = (shipIndex-1+ships.length)%ships.length;
        if(mx > 335 && mx < 375 && my > 275 && my < 335) shipIndex = (shipIndex+1)%ships.length;
    } else if(state === "gameover") state = "lobby";
});

document.addEventListener("keydown", e => {
    keys[e.key] = true;
    if(state === "game" && e.key === " ") shoot();
    if(state === "game" && e.key === "Control" && shieldReady) activateShield();
});
document.addEventListener("keyup", e => keys[e.key] = false);

function changeShip(dir) { do { shipIndex = (shipIndex + dir + ships.length) % ships.length; } while (!save.owned[shipIndex]); }
function saveGame() { save.score = score; localStorage.setItem("spaceSave", JSON.stringify(save)); }
function startGame() { bullets = []; enemies = []; particles = []; bonuses = []; enemyTimer = 0; speedTimer = 0; multiTimer = 0; shieldActive = false; shieldReady = false; enemyKills = 0; player.x = 210; state = "game"; }
function buyShip() { let s = ships[shipIndex]; if(!save.owned[shipIndex] && score >= s.price) { score -= s.price; save.owned[shipIndex] = true; saveGame(); } }

function shoot() {
    if(multiTimer > 0) {
        bullets.push({x: player.x - 15, y: player.y}, {x: player.x, y: player.y}, {x: player.x + 15, y: player.y});
        particles.push({ x: player.x - 15, y: player.y, dx: 0, dy: 5, life: 15, c: "#00ffff" });
        particles.push({ x: player.x + 15, y: player.y, dx: 0, dy: 5, life: 15, c: "#00ffff" });
    } else {
        bullets.push({x: player.x, y: player.y});
        particles.push({ x: player.x, y: player.y, dx: 0, dy: 5, life: 12, c: "#00ff88" });
    }
}

function activateShield() { if(ships[shipIndex].color === "#ff00ff") { shieldActive = true; shieldReady = false; shieldTimer = 400; enemyKills = 0; } }

function explode(x, y, big = false) {
    let colors = big ? ["#ffaa00", "#ff6600", "#ff0000"] : ["#00ffff", "#00ff88", "#00aaff"];
    for(let i=0; i<(big?50:20); i++) {
        particles.push({ 
            x, y, 
            dx: (Math.random()-0.5)*(big?8:5), 
            dy: (Math.random()-0.5)*(big?8:5), 
            life: big ? 40 : 30, 
            c: colors[Math.floor(Math.random()*colors.length)]
        });
    }
}

function drawGradientText(text, x, y, size, color1, color2) {
    let gradient = ctx.createLinearGradient(x - text.length * size/2, y - size/2, x + text.length * size/2, y + size/2);
    gradient.addColorStop(0, color1);
    gradient.addColorStop(1, color2);
    ctx.fillStyle = gradient;
    ctx.fillText(text, x, y);
}

function drawShip(x, y, color, size, dir="up") {
    ctx.save(); 
    ctx.translate(x, y); 
    if(dir === "down") ctx.rotate(Math.PI);
    
    // Brillo de nave
    ctx.fillStyle = color;
    ctx.shadowBlur = 20;
    ctx.shadowColor = color;
    
    // Triángulo principal
    ctx.beginPath(); 
    ctx.moveTo(0, -size); 
    ctx.lineTo(size, size); 
    ctx.lineTo(-size, size); 
    ctx.closePath(); 
    ctx.fill();
    
    // Detalles de luz
    ctx.fillStyle = "rgba(255,255,255,0.3)";
    ctx.beginPath();
    ctx.moveTo(0, -size*0.8);
    ctx.lineTo(size*0.5, -size*0.2);
    ctx.lineTo(-size*0.5, -size*0.2);
    ctx.closePath();
    ctx.fill();
    
    ctx.restore();
}

function drawButton(x, y, w, h, text, color1, color2, textColor) {
    let gradient = ctx.createLinearGradient(x, y, x+w, y+h);
    gradient.addColorStop(0, color1);
    gradient.addColorStop(1, color2);
    ctx.fillStyle = gradient;
    ctx.fillRect(x, y, w, h);
    
    ctx.strokeStyle = color1;
    ctx.lineWidth = 2;
    ctx.strokeRect(x, y, w, h);
    
    ctx.fillStyle = textColor;
    ctx.font = "bold 18px Orbitron";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(text, x + w/2, y + h/2);
    ctx.textAlign = "left";
}

function loop() {
    ctx.clearRect(0, 0, 420, 650);
    
    // Fondo dinámico
    let bgGradient = ctx.createLinearGradient(0, 0, 0, 650);
    bgGradient.addColorStop(0, "rgba(10, 10, 20, 0.3)");
    bgGradient.addColorStop(0.5, "rgba(15, 10, 30, 0.2)");
    bgGradient.addColorStop(1, "rgba(5, 5, 15, 0.4)");
    ctx.fillStyle = bgGradient;
    ctx.fillRect(0, 0, 420, 650);
    
    // Estrellas mejoradas
    stars.forEach(s => { 
        s.y += s.s; 
        if(s.y > 650) s.y = 0; 
        ctx.fillStyle = `rgba(255, 255, 255, ${0.3 + Math.sin(s.br)*0.3})`;
        ctx.fillRect(s.x, s.y, 1.5, 1.5);
    });

    if(state === "lobby") {
        // Fondo especial lobby
        let lobbyGradient = ctx.createLinearGradient(0, 0, 420, 650);
        lobbyGradient.addColorStop(0, "rgba(0, 255, 255, 0.05)");
        lobbyGradient.addColorStop(0.5, "rgba(255, 0, 255, 0.05)");
        lobbyGradient.addColorStop(1, "rgba(0, 255, 136, 0.05)");
        ctx.fillStyle = lobbyGradient;
        ctx.fillRect(0, 0, 420, 650);
        
        // Título
        ctx.font = "bold 48px Orbitron";
        ctx.textAlign = "center";
        drawGradientText("SPACE", 210, 80, 48, "#00ffff", "#00ff88");
        drawGradientText("BATTLE X", 210, 130, 48, "#00ff88", "#ff00ff");
        ctx.textAlign = "left";
        
        // Nave seleccionada
        ctx.shadowBlur = 30;
        ctx.shadowColor = ships[shipIndex].glow;
        drawShip(210, 280, ships[shipIndex].color, 40);
        ctx.shadowBlur = 0;
        
        // Navegación de naves
        ctx.font = "bold 32px Orbitron";
        ctx.fillStyle = "#00ffff";
        ctx.fillText("◄", 55, 295);
        ctx.fillText("►", 345, 295);
        
        // Botón Jugar
        drawButton(100, 420, 220, 55, "¡ JUGAR !", "#00ff88", "#00ffaa", "#000");
        
        // Tienda
        ctx.fillStyle = "rgba(255, 100, 0, 0.8)";
        ctx.shadowBlur = 15;
        ctx.shadowColor = "#ff6600";
        ctx.beginPath();
        ctx.arc(370, 580, 28, 0, Math.PI*2);
        ctx.fill();
        ctx.shadowBlur = 0;
        
        ctx.fillStyle = "#000";
        ctx.font = "28px Arial";
        ctx.textAlign = "center";
        ctx.fillText("🛒", 370, 590);
        ctx.textAlign = "left";
        
        // Score
        ctx.font = "bold 20px Orbitron";
        drawGradientText("⭐ " + score, 15, 40, 20, "#ffff00", "#ff8800");
        
        requestAnimationFrame(loop); 
        return;
    }

    if(state === "shop") {
        // Fondo tienda
        let shopGradient = ctx.createLinearGradient(0, 0, 420, 650);
        shopGradient.addColorStop(0, "rgba(255, 0, 100, 0.05)");
        shopGradient.addColorStop(1, "rgba(100, 0, 255, 0.05)");
        ctx.fillStyle = shopGradient;
        ctx.fillRect(0, 0, 420, 650);
        
        ctx.font = "bold 40px Orbitron";
        ctx.fillStyle = "white";
        ctx.textAlign = "center";
        ctx.fillText("⚙ TIENDA", 210, 70);
        ctx.textAlign = "left";
        
        ctx.shadowBlur = 35;
        ctx.shadowColor = ships[shipIndex].glow;
        drawShip(210, 280, ships[shipIndex].color, 50);
        ctx.shadowBlur = 0;
        
        ctx.font = "bold 24px Orbitron";
        ctx.fillStyle = "#00ffff";
        ctx.fillText("◄", 50, 295);
        ctx.fillText("►", 345, 295);
        
        let s = ships[shipIndex];
        if(save.owned[shipIndex]) { 
            ctx.fillStyle = "#00ff88";
            ctx.font = "bold 22px Orbitron";
            ctx.textAlign = "center";
            ctx.fillText("✓ ADQUIRIDA", 210, 420);
            ctx.textAlign = "left";
        } else { 
            ctx.font = "bold 20px Orbitron";
            ctx.fillStyle = "#ffff00";
            ctx.textAlign = "center";
            ctx.fillText("💰 " + s.price, 210, 410);
            
            let btnColor1 = score >= s.price ? "#ff6600" : "#444466";
            let btnColor2 = score >= s.price ? "#ffaa00" : "#555577";
            drawButton(80, 435, 260, 45, "COMPRAR", btnColor1, btnColor2, score >= s.price ? "#000" : "#888");
            ctx.textAlign = "left";
        }
        
        ctx.fillStyle = "#ff4444";
        ctx.font = "bold 18px Orbitron";
        ctx.textAlign = "center";
        ctx.fillText("VOLVER", 210, 610);
        ctx.textAlign = "left";
        
        requestAnimationFrame(loop); 
        return;
    }

    if(state === "gameover") {
        ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
        ctx.fillRect(0, 0, 420, 650);
        
        ctx.font = "bold 60px Orbitron";
        ctx.textAlign = "center";
        drawGradientText("GAME OVER", 210, 280, 60, "#ff0000", "#ff6600");
        
        ctx.font = "bold 20px Orbitron";
        ctx.fillStyle = "#ffff00";
        ctx.fillText("PUNTUACIÓN: " + score, 210, 380);
        
        ctx.fillStyle = "#00ffff";
        ctx.fillText("CLIC PARA VOLVER", 210, 450);
        ctx.textAlign = "left";
        
        requestAnimationFrame(loop); 
        return;
    }

    // --- JUEGO ---
    let currentSpeed = ships[shipIndex].speed + (speedTimer > 0 ? 4 : 0);
    if(keys["ArrowLeft"] && player.x > 25) player.x -= currentSpeed;
    if(keys["ArrowRight"] && player.x < 395) player.x += currentSpeed;
    
    if(shieldActive) { 
        ctx.strokeStyle = "#00ffff";
        ctx.shadowBlur = 20;
        ctx.shadowColor = "#00ffff";
        ctx.lineWidth = 3; 
        ctx.beginPath(); 
        ctx.arc(player.x, player.y+5, 40, 0, Math.PI*2); 
        ctx.stroke(); 
        ctx.shadowBlur = 0;
        shieldTimer--; 
        if(shieldTimer <= 0) shieldActive = false;
    }
    
    ctx.shadowBlur = 15;
    ctx.shadowColor = ships[shipIndex].glow;
    drawShip(player.x, player.y, ships[shipIndex].color, 20);
    ctx.shadowBlur = 0;

    // BARRAS DE TIEMPO INDEPENDIENTES
    if(speedTimer > 0) {
        let barGradient = ctx.createLinearGradient(player.x - 35, player.y + 30, player.x + 35, player.y + 30);
        barGradient.addColorStop(0, "#0088ff");
        barGradient.addColorStop(1, "#00ffff");
        ctx.fillStyle = barGradient;
        ctx.fillRect(player.x - 30, player.y + 30, (speedTimer/BONUS_DURATION)*60, 6);
        ctx.strokeStyle = "#00ffff";
        ctx.lineWidth = 1;
        ctx.strokeRect(player.x - 30, player.y + 30, 60, 6);
        speedTimer--;
    }
    if(multiTimer > 0) {
        let barGradient = ctx.createLinearGradient(player.x - 35, player.y + 40, player.x + 35, player.y + 40);
        barGradient.addColorStop(0, "#ff0088");
        barGradient.addColorStop(1, "#ff00ff");
        ctx.fillStyle = barGradient;
        ctx.fillRect(player.x - 30, player.y + 40, (multiTimer/BONUS_DURATION)*60, 6);
        ctx.strokeStyle = "#ff00ff";
        ctx.lineWidth = 1;
        ctx.strokeRect(player.x - 30, player.y + 40, 60, 6);
        multiTimer--;
    }

    // Balas mejoradas
    bullets.forEach((b, i) => { 
        b.y -= 10; 
        ctx.shadowBlur = 10;
        ctx.shadowColor = "#ffff00";
        ctx.fillStyle = "#ffff00"; 
        ctx.fillRect(b.x-2, b.y, 4, 12);
        ctx.shadowBlur = 0;
        if(b.y < 0) bullets.splice(i, 1); 
    });
    
    enemyTimer++; 
    if(enemyTimer > 45) { 
        enemies.push({x: Math.random()*380+20, y: -40}); 
        enemyTimer = 0; 
    }

    enemies.forEach((e, i) => {
        e.y += 3; 
        ctx.shadowBlur = 15;
        ctx.shadowColor = "#ff0066";
        drawShip(e.x, e.y, "#ff0066", 18, "down");
        ctx.shadowBlur = 0;
        
        if(Math.hypot(e.x - player.x, e.y - player.y) < 30) { 
            if(shieldActive) { 
                explode(e.x, e.y); 
                enemies.splice(i,1); 
            } else { 
                explode(player.x, player.y, true); 
                state = "gameover"; 
                saveGame(); 
            } 
        }
        
        bullets.forEach((b, j) => {
            if(Math.hypot(e.x - b.x, e.y - b.y) < 20) { 
                explode(e.x, e.y); 
                enemies.splice(i,1); 
                bullets.splice(j,1); 
                score += 10; 
                enemyKills++; 
                if(enemyKills >= 12) shieldReady = true; 
                if(Math.random() < 0.15) bonuses.push({x: e.x, y: e.y, type: Math.random() < 0.5 ? "speed" : "multi"});
            }
        });
        if(e.y > 670) enemies.splice(i,1);
    });

    bonuses.forEach((bo, i) => {
        bo.y += 2; 
        ctx.shadowBlur = 15;
        ctx.shadowColor = bo.type === "speed" ? "#00ffff" : "#ff00ff";
        ctx.fillStyle = bo.type === "speed" ? "#00ffff" : "#ff00ff"; 
        ctx.fillRect(bo.x-12, bo.y-12, 24, 24);
        
        // Símbolo bonus
        ctx.fillStyle = bo.type === "speed" ? "#000" : "#000";
        ctx.font = "bold 16px Arial";
        ctx.textAlign = "center";
        ctx.fillText(bo.type === "speed" ? "⚡" : "✕2", bo.x, bo.y+4);
        ctx.textAlign = "left";
        
        ctx.shadowBlur = 0;
        
        if(Math.hypot(bo.x - player.x, bo.y - player.y) < 30) { 
            if(bo.type === "speed") speedTimer = BONUS_DURATION; 
            else multiTimer = BONUS_DURATION; 
            bonuses.splice(i,1); 
        }
    });

    particles.forEach((p, i) => { 
        p.x += p.dx; 
        p.y += p.dy; 
        p.life--; 
        ctx.fillStyle = p.c; 
        ctx.globalAlpha = p.life/30; 
        ctx.shadowBlur = 8;
        ctx.shadowColor = p.c;
        ctx.fillRect(p.x, p.y, 4, 4); 
        ctx.shadowBlur = 0;
        ctx.globalAlpha = 1; 
        if(p.life <= 0) particles.splice(i,1); 
    });

    // HUD
    ctx.font = "bold 18px Orbitron";
    drawGradientText("⊙ SCORE: " + score, 15, 25, 18, "#ffff00", "#ff8800");
    
    if(ships[shipIndex].color === "#ff00ff") { 
        ctx.font = "bold 14px Orbitron";
        ctx.fillStyle = shieldReady ? "#00ffff" : "#cccccc"; 
        ctx.fillText(shieldReady ? "◆ ESCUDO LISTO (CTRL)" : "◇ CARGA: " + enemyKills + "/12", 15, 50); 
    }

    requestAnimationFrame(loop);
}
loop();
</script>
</body>
</html>
